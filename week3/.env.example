WEATHER_BASE_URL=https://api.open-meteo.com/v1
WEATHER_GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/v1
WEATHER_TIMEOUT_SECONDS=10
WEATHER_USER_AGENT=week3-mcp-weather-server/1.0
WEATHER_RETRY_ATTEMPTS=2
WEATHER_BACKOFF_SECONDS=0.2
MCP_LOG_LEVEL=INFO

MCP_AUTH_REQUIRED=true
MCP_AUTH_PROVIDER=github
MCP_AUTH_RESOURCE_SERVER_URL=http://127.0.0.1:8000
MCP_AUTH_REQUIRED_SCOPES=read:user

GITHUB_OAUTH_ENABLED=true
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/auth/github/callback
GITHUB_OAUTH_SCOPES=read:user
